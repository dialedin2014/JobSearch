# Required: Anthropic API Key for Claude 3 Sonnet
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
# For development (SQLite)
DATABASE_URL=sqlite:///./jobsearch_dev.db
# For production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/jobsearch_prod

# External API Keys (Optional - for ally discovery feature)
GITHUB_API_TOKEN=your_github_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
LINKEDIN_API_KEY=your_linkedin_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here

# Application Settings
APP_NAME=Dream Job Ally Deduction
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your_secret_key_for_jwt_signing
JWT_SECRET_KEY=your_jwt_secret_key_here_use_strong_random_string
JWT_ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# LLM Settings
LLM_MODEL=claude-3-sonnet-20240229
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_CACHE_TTL=86400

# External API Rate Limits
GITHUB_RATE_LIMIT=5000
TWITTER_RATE_LIMIT=300
